<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    DevOpsStore.* packages come from the internal "devops-store" feed; everything else from nuget.org.
    The default value is a local folder filled by `dotnet pack` in server/building-blocks.
    Replace it with your real feed URL (for example an Azure Artifacts feed) for pipeline builds.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="devops-store" value="../building-blocks/artifacts/packages" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="devops-store">
      <package pattern="DevOpsStore.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
