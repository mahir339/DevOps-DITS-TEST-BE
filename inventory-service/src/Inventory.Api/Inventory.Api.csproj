<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- API layer: the runnable ASP.NET Core host (this is the project that gets published). -->

  <PropertyGroup>
    <!-- Local secrets (connection strings, JWT key): dotnet user-secrets set "ConnectionStrings:InventoryDb" "..." -->
    <UserSecretsId>devops-store-inventory-4b1b8edc-6944-4a51-8d3b-0cdde949e09c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DevOpsStore.BuildingBlocks.Messaging" />
    <PackageReference Include="DevOpsStore.BuildingBlocks.Persistence" />
    <PackageReference Include="DevOpsStore.BuildingBlocks.Security" />
    <PackageReference Include="DevOpsStore.BuildingBlocks.Web" />
    <!-- Needed by the dotnet-ef tool (migrations); not part of the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
    <ProjectReference Include="..\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
