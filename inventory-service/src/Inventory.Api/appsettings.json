{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Version": "1.0.0"
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  },
  "Jwt": {
    "Issuer": "devops-store-identity",
    "Audience": "devops-store-api"
  },
  "Database": {
    "MigrateOnStartup": false,
    "FailOnPendingMigrations": true
  },
  "Messaging": {
    "Exchange": "devops-store.events",
    "PrefetchCount": 10,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 1000
  }
}
