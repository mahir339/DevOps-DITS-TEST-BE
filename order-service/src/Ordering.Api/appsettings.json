{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Version": "1.0.0"
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  },
  "Jwt": {
    "Issuer": "devops-store-identity",
    "Audience": "devops-store-api"
  },
  "Database": {
    "MigrateOnStartup": false,
    "FailOnPendingMigrations": true
  },
  "Services": {
    "CatalogUrl": "http://localhost:5001",
    "CustomerUrl": "http://localhost:5002",
    "InventoryUrl": "http://localhost:5003",
    "TimeoutSeconds": 5
  },
  "Outbox": {
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 20
  }
}
