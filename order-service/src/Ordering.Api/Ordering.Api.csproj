<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- API layer: the runnable ASP.NET Core host (this is the project that gets published). -->

  <PropertyGroup>
    <!-- Local secrets (connection strings, JWT key): dotnet user-secrets set "ConnectionStrings:OrderingDb" "..." -->
    <UserSecretsId>devops-store-ordering-e723230d-4e9c-4b74-95e8-ca8432912364</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DevOpsStore.BuildingBlocks.Messaging" />
    <PackageReference Include="DevOpsStore.BuildingBlocks.Persistence" />
    <PackageReference Include="DevOpsStore.BuildingBlocks.Security" />
    <PackageReference Include="DevOpsStore.BuildingBlocks.Web" />
    <!-- Needed by the dotnet-ef tool (migrations); not part of the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ordering.Application\Ordering.Application.csproj" />
    <ProjectReference Include="..\Ordering.Infrastructure\Ordering.Infrastructure.csproj" />
  </ItemGroup>

</Project>
