{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Version": "1.0.0"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4300"
    ]
  },
  "Jwt": {
    "Issuer": "devops-store-identity",
    "Audience": "devops-store-api"
  },
  "Gateway": {
    "LoginPermitsPerMinute": 10,
    "BlockedPathPatterns": [
      "^/api/inventory/[^/]+/(reserve|release)/?$"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth": {
        "ClusterId": "identity",
        "Order": 2,
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "users": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/users/{**rest}"
        }
      },
      "products-read": {
        "ClusterId": "catalog",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/products/{**rest}",
          "Methods": [
            "GET"
          ]
        }
      },
      "products-write": {
        "ClusterId": "catalog",
        "Order": 2,
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/products/{**rest}"
        }
      },
      "customers": {
        "ClusterId": "customer",
        "AuthorizationPolicy": "staff",
        "Match": {
          "Path": "/api/customers/{**rest}"
        }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "staff",
        "Match": {
          "Path": "/api/inventory/{**rest}"
        }
      },
      "orders": {
        "ClusterId": "order",
        "AuthorizationPolicy": "staff",
        "Match": {
          "Path": "/api/orders/{**rest}"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/notifications/{**rest}"
        }
      },
      "status-identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/status/identity/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/status/identity"
          }
        ]
      },
      "status-catalog": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/status/catalog/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/status/catalog"
          }
        ]
      },
      "status-customer": {
        "ClusterId": "customer",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/status/customer/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/status/customer"
          }
        ]
      },
      "status-inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/status/inventory/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/status/inventory"
          }
        ]
      },
      "status-order": {
        "ClusterId": "order",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/status/order/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/status/order"
          }
        ]
      },
      "status-notification": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/status/notification/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/status/notification"
          }
        ]
      },
      "status-notification-worker": {
        "ClusterId": "notification-worker",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/status/notification-worker/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/status/notification-worker"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5006/"
          }
        }
      },
      "catalog": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "customer": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "inventory": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "order": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "notification": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5005/"
          }
        }
      },
      "notification-worker": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5007/"
          }
        }
      }
    }
  }
}
